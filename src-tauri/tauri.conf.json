{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VisualLLM",
  "version": "0.5.1",
  "identifier": "app.visualllm",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VisualLLM",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "decorations": false,
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwOTY4OEEzQjhGOUEwMzQKUldRMG9QbTRvNGlXNEdPMWllbGVIdXQwSU8ySU5TOFI3UE83eUUrSXNjZHgrRTNvZW55dnh2T2QK",
      "endpoints": [
        "https://github.com/CreativeSystemDesign/visualllm/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "appimage",
      "msi",
      "nsis",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Visual fallback router for model endpoints",
    "longDescription": "Arrange models from your providers into local OpenAI-compatible fallback endpoints.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    }
  }
}
